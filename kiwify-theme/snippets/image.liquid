{% comment %} Helper snippet to display optimized images using Kiwify's native image component {% endcomment %}
{%- capture props -%}
{
  "src": "{{ src }}"
  {%- if preload != blank -%}, "preload": {{ preload }}{%- endif -%}
  {%- if fadeIn != blank -%}, "fadeIn": {{ fadeIn }}{%- endif -%}
  {%- if width -%}, "width": {{ width }}{%- endif -%}
  {%- if height -%}, "height": {{ height }}{%- endif -%}
  {%- if fit -%}, "fit": "{{ fit }}"{%- endif -%}
  {%- if class -%}, "class": "{{ class }}"{%- endif -%}
  {%- if wrapper_json -%}, "wrapper": {{ wrapper_json }}{%- endif -%}
  {%- if format -%}, "format": "{{ format }}"{%- endif -%}
}
{%- endcapture -%}

<div
  data-kiwi-component="ClubImage"
  data-hydrate="true"
  data-props="{{ props | escape }}"
  class="club-image-container"
></div>

{% comment %} Initialize image dimensions and layout variables {% endcomment %}
{% assign image_width = 400 %}
{% assign image_height = 600 %}
{% assign aspect_ratio_class = 'aspect-[2/3]' %}
{% assign progress_bar_wrapper_class = 'z-10 absolute bottom-0 inset-x-0 flex flex-row items-center justify-center rounded-none overflow-hidden' %}

{% if is_horizontal %}
  {% assign image_width = 640 %}
  {% assign image_height = 360 %}
  {% assign aspect_ratio_class = 'aspect-[16/9]' %}
  {% assign progress_bar_wrapper_class = 'pt-2 mx-auto w-3/4' %}
{% endif %}

{% comment %} Initialize variables {% endcomment %}
{% assign image_url = item.thumbnail_slider_cover | default: item.logo_url | default: item.thumbnail %}
{% assign progress = 0 %}
{% assign visible = item.user_data.visible %}
{% assign external_link = item.custom_offer.external_link %}
{% comment %} Check if purchasable: not visible AND (has custom offer OR has external link) {% endcomment %}
{% assign is_purchasable = false %}
{% unless visible %}
  {% if item.custom_offer.enabled or external_link != blank %}
    {% assign is_purchasable = true %}
  {% endif %}
{% endunless %}

{% comment %} Delivery date always comes, so we check if it is before "now" to assign it locally {% endcomment %}
{% assign now = 'now' | date: '%s', 'UTC' %}
{% assign delivery_date_timestamp = item.user_data.delivery_date | date: '%s', 'UTC' %}
{% if delivery_date_timestamp > now %}
  {% assign delivery_date = item.user_data.delivery_date %}
{% endif %}

{% comment %} Determine if actually disabled {% endcomment %}
{% if is_preview %}
  {% comment %} In preview/editor mode, never disable {% endcomment %}
  {% assign is_disabled = false %}
{% elsif item.user_data.expired or delivery_date %}
  {% comment %} Disabled if expired or has delivery date {% endcomment %}
  {% assign is_disabled = true %}
{% else %}
  {% comment %} Disabled if NOT purchasable AND (not visible OR content_count is 0) {% endcomment %}
  {% unless is_purchasable %}
    {% assign content_count = item.user_data.content_count %}
    {% if visible == false or content_count == 0 %}
      {% assign is_disabled = true %}
    {% else %}
      {% assign is_disabled = false %}
    {% endif %}
  {% else %}
    {% assign is_disabled = false %}
  {% endunless %}
{% endif %}

{% comment %} Tooltip text for disabled cards {% endcomment %}
{% assign tooltip_text = '' %}

{% if item.user_data.expired %}
  {% assign tooltip_text = 'content.expired' | t %}
{% elsif delivery_date %}
  {% assign delivery_date_formatted = delivery_date | date: '%B %d, %Y', 'UTC' %}
  {% assign tooltip_text = 'content.upcoming' | t: date: delivery_date_formatted %}
{% elsif is_disabled %}
  {% assign tooltip_text = 'content.locked' | t %}
{% endif %}

{% comment %} Disabled or purchasable cards have status icons {% endcomment %}
{% assign has_status_icon = item.user_data.expired or item.user_data.delivery_date or is_purchasable or external_link != blank and visible == false %}

{% comment %} Progress calculation {% endcomment %}
{% assign progress = item.user_data[percentage_field] | default: 0 %}

{% comment %} Router path {% endcomment %}
{% if is_preview %}
  {% assign router_path = '' %}
{% else %}
  {% assign router_path = path_format | default: '/{id}' %}
  {% if item.course_id %}
    {% assign router_path = router_path | replace: '{course_id}', item.course_id %}
  {% endif %}
  {% if item.module_id %}
    {% assign router_path = router_path | replace: '{module_id}', item.module_id %}
  {% endif %}
  {% comment %}
    This condition matches an unaccessible lesson with purchase conditions.
    Lessons lead directly to the lesson page, and do not open the purchase modal.
    Removing the ID from the path will lead to the purchase modal when possible.
  {% endcomment %}
  {% if item.module_id and is_purchasable %}
    {% assign router_path = router_path | replace: '{id}', '' %}
  {% else %}
    {% assign router_path = router_path | replace: '{id}', item.id %}
  {% endif %}
{% endif %}

{% comment %} Determine wrapper element and attributes {% endcomment %}
{% if is_disabled %}
  {% comment %} Disabled cards should do nothing, so we use a div without any attributes {% endcomment %}
  {% assign wrapper_tag = 'div' %}
  {% assign wrapper_attrs = '' %}
{% elsif external_link != blank and visible == false %}
  {% comment %} If the card has an external link and its content is not accessible, it should be wrapped in an anchor tag with the href and target attributes {% endcomment %}
  {% assign wrapper_tag = 'a' %}
  {% assign wrapper_attrs = 'href="' | append: external_link | append: '" target="_blank"' %}
{% else %}
  {% comment %} If the card is not disabled, we use a div with the data-kiwi-router-link attribute to allow navigation to the card's corresponding page {% endcomment %}
  {% assign wrapper_tag = 'div' %}
  {% assign wrapper_attrs = 'data-kiwi-router-link="' | append: router_path | append: '"' %}
{% endif %}

{% comment %} Card rendering {% endcomment %}
<div
  class="embla__slide{% if is_disabled %} cursor-not-allowed pointer-events-auto grayscale opacity-95{% else %} cursor-pointer focus:scale-105 hover:scale-105{% endif %} relative sci group/sci block z-0 hover:z-10 rounded-none transform transition-all ease-in-out duration-300 scale-100 {% if is_horizontal %}w-8/12 md:w-64{% else %}w-5/12 md:w-64{% endif %}"
  {% if tooltip_text != blank and is_disabled %}
    aria-label="{{ tooltip_text }}" data-microtip-position="top" role="tooltip"
  {% endif %}
>
  <{{ wrapper_tag }}
    {% if wrapper_attrs != blank %}
      {{ wrapper_attrs -}}
    {% endif %}
  >
    <div class="relative">
      {% comment %} Image {% endcomment %}
      {% if image_url != blank %}
        {% assign image_class = 'rounded-none select-none transition-all ease-in-out duration-300 bg-[#0e0e11] object-contain '
          | append: aspect_ratio_class
        %}
        {% render 'image',
          src: image_url,
          width: image_width,
          height: image_height,
          class: image_class,
          wrapper_json: '{"class": "rounded-none sci__img z-10 relative select-none leading-[0px]"}'
        %}
      {% else %}
        {% comment %} If the card has no image, we display a placeholder {% endcomment %}
        <div class="z-10 relative select-none">
          <div class="rounded-none select-none transition-all ease-in-out duration-300 bg-[#0e0e11] flex items-center justify-center {% if is_horizontal %}aspect-[16/9]{% else %}aspect-[2/3]{% endif %}">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-12 h-12 text-[#84848c]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
      {% endif %}
      {% comment %} Title is rendered over the image if the items_variant is set to mouse_hover or content_over {% endcomment %}
      {% if section.settings.items_variant == 'mouse_hover' or section.settings.items_variant == 'content_over' %}
        <div class="absolute inset-x-0 bottom-0 z-10 py-3 px-4 {% if is_disabled == false and is_horizontal == false and progress > 0 %}pb-4{% endif %}">
          <h3 class="font-bold text-base md:text-lg line-clamp-2 {% if section.settings.items_variant == 'mouse_hover' %}transition-all ease-in-out duration-150 opacity-0 group-focus/sci:opacity-100 group-hover/sci:opacity-100{% endif %}">
            {{ item.name }}
          </h3>
        </div>
      {% endif %}

      {% comment %} Progress bar {% endcomment %}
      {% if is_disabled == false and should_display_progress and progress > 0 %}
        <div class="{{ progress_bar_wrapper_class }}">
          <progress
            aria-valuemax="100"
            aria-valuenow="{{ progress }}"
            class="block appearance-none border-none overflow-hidden w-full [&::-webkit-progress-bar]:w-full h-1 rounded-none [&::-webkit-progress-bar]:rounded-none [&::-webkit-progress-bar]:bg-[#1f1f24] [&::-webkit-progress-bar]:dark:bg-[#1f1f24] [@supports(selector(&::-moz-progress-bar))]:bg-[#1f1f24] [@supports(selector(&::-moz-progress-bar))]:dark:bg-[#1f1f24] [&::-webkit-progress-value]:rounded-none [&::-webkit-progress-value]:transition-all [&::-webkit-progress-value]:ease-in-out [&::-moz-progress-bar]:rounded-none text-[#ff3a0e] [&::-webkit-progress-value]:bg-current [&::-moz-progress-bar]:bg-current indeterminate:relative indeterminate:after:rounded-full [&:indeterminate::-webkit-progress-value]:rounded-full [&:indeterminate::-moz-progress-bar]:rounded-full"
            max="100"
            value="{{ progress }}"
          >
            {{ progress }}%
          </progress>
        </div>
      {% endif %}

      {% comment %} Status icons {% endcomment %}
      {% assign show_external_icon = false %}
      {% if external_link != blank and visible == false %}
        {% assign show_external_icon = true %}
      {% endif %}

      {% if item.user_data.expired or delivery_date or is_purchasable or show_external_icon %}
        <div class="absolute z-10 top-2 right-2 md:top-4 md:right-4 flex gap-2">
          {% if item.user_data.expired or delivery_date %}
            <span class="bg-[#16161a] text-[#f1f1f3] rounded-none p-1 md:p-2 shadow-md">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
          {% endif %}

          {% if is_purchasable %}
            <span class="bg-[#16161a] text-[#f1f1f3] rounded-none p-1 md:p-2 shadow-md">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V12.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25ZM10.5 6.75a1.5 1.5 0 0 1 3 0v3h-3v-3Z" clip-rule="evenodd" />
              </svg>
            </span>
          {% endif %}

          {% if external_link != blank and visible == false %}
            <span class="bg-[#16161a] text-[#f1f1f3] rounded-none p-1 md:p-2 shadow-md">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% comment %} Editor mode cover management button, shown only in theme editor {% endcomment %}
      {% if is_preview and source == 'theme-editor' %}
        <div class="absolute z-10 top-4 right-4 transition-all ease-in-out duration-150 opacity-0 group-focus/sci:opacity-100 group-hover/sci:opacity-100">
          <button
            type="button"
            class="outline-none focus:outline-none bg-black bg-opacity-50 hover:bg-opacity-75 active:bg-opacity-100 text-white flex items-center justify-center gap-1.5 rounded-full text-sm p-2 transition-all ease-in-out duration-300"
            data-kiwi-editor-event='{"name": "manageCover", "type": "{{ section.type }}", "id": "{{ item.id }}"}'
          >
            {% if image_url != blank %}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157l3.712 3.712l1.157-1.157a2.625 2.625 0 0 0 0-3.712m-2.218 5.93l-3.712-3.712l-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32z"></path>
                <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5z"></path>
              </svg>
            {% else %}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              >
                <path d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0a9 9 0 0 1 18 0"></path>
              </svg>
            {% endif %}
          </button>
        </div>
      {% endif %}
    </div>
  </{{ wrapper_tag }}>
</div>

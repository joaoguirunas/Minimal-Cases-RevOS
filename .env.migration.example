# ============================================================
# ORA — Migração de Configuração entre projetos Supabase
# Copie para .env.migration e preencha os valores reais.
# NUNCA commite .env.migration (já está no .gitignore).
# ============================================================

# ── SOURCE (projeto de origem) ──────────────────────────────
SOURCE_URL=https://wczlvfdfzipoexybeesy.supabase.co
SOURCE_SERVICE_KEY=eyJ...   # Settings > API > service_role

# UUID do tenant no projeto de origem.
# Se deixar vazio, o script tenta detectar automaticamente via crm_tenants.
# Se o source tiver apenas 1 tenant, funciona sem preencher.
SOURCE_TENANT_ID=

# ── DESTINATION (projeto de destino) ────────────────────────
DEST_URL=https://xiucvgrwfleffqlozoad.supabase.co
DEST_SERVICE_KEY=eyJ...     # Settings > API > service_role

# UUID do tenant no projeto de destino.
# Se deixar vazio, o script tenta detectar automaticamente.
DEST_TENANT_ID=

# ── Controle de execução ─────────────────────────────────────
# true  → apenas lê e reporta, não escreve nada (recomendado rodar primeiro)
# false → executa a migração real
DRY_RUN=true
